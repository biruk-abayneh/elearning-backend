# Copy this file to .env and fill in real values (never commit .env).

# Supabase
SUPABASE_URL=https://xhpqmrihahhuxywbooiz.supabase.co
# Use the SERVICE ROLE key here (Settings -> API -> service_role). Keep it secret.
SUPABASE_KEY=

# Google Gemini — used by the AI tutor + recommendations.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
# Generation model (Gemma 4 26B via the Gemini API)
AI_TUTOR_MODEL=gemma-4-26b-a4b-it
# Embedding model (must be a Gemini embedding model, 768-dim)
AI_EMBEDDING_MODEL=gemini-embedding-001

# Server
PORT=3000
